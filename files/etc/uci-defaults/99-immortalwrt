#!/bin/sh
# 首启定制：LAN 出厂地址 + root 密码 + 主机名/主题（其余全默认，恢复阶段再动）
# uci-defaults 机制：boot() 逐文件子进程 source，exit 0 才自删
# 注意 1：禁用 set -e —— uci delete 对不存在的项返回 1，set -e 会把后面的步骤静默杀掉（25.12 实测教训）
# 注意 2：/etc/config/network、system 不在镜像内，由 preinit 阶段 config_generate 生成（默认主机名 ImmortalWrt），uci-defaults 在其后运行、负责覆盖
# 注意 3：LAN DNS 出厂保持留空（用户决定），上游解析由恢复阶段配置

# root 密码 = password（dropbear 密码登录开箱可用，恢复期 SSH 靠它）
printf 'password\npassword\n' | passwd root >/dev/null 2>&1 || true

# LAN 出厂地址（iKuai 在 .1，本机必须 static .2 才不冲突、网关指回 .1）
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.2'
uci set network.lan.netmask='255.255.255.0'
uci set network.lan.gateway='192.168.1.1'
uci commit network

# LuCI 默认启用 Argon 主题；主机名用 OpenWrt（覆盖 config_generate 生成的 ImmortalWrt）
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci
uci set system.@system[0].hostname='OpenWrt'
uci commit system

exit 0
